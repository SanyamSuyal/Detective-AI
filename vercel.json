{
  "version": 2,
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/index.ts"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "COHERE_API_KEY": "@cohere_api_key",
    "OPENAI_API_KEY": "@openai_api_key"
  }
}