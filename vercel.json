{
  "version": 2,
  "buildCommand": "./vercel-build.sh",
  "outputDirectory": "public",
  "builds": [
    {
      "src": "server/vercel.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { 
      "src": "/api/(.*)", 
      "dest": "/server/vercel.ts" 
    },
    { 
      "src": "/uploads/(.*)",
      "dest": "/server/vercel.ts"
    },
    {
      "handle": "filesystem"
    },
    { 
      "src": "/(.*)",
      "dest": "/server/vercel.ts"
    }
  ]
}